    },
    {
      "source": "/en/morpheus8-olten(\\.html)?",
      "destination": "/en#t-morpheus8-olten",
      "permanent": true
    },
    {
      "source": "/en/plasma-pen-olten(\\.html)?",
      "destination": "/en#t-plasma-pen-olten",
      "permanent": true
    },
    {
      "source": "/en/permanent-make-up-olten(\\.html)?",
      "destination": "/en#t-permanent-make-up-olten",
      "permanent": true
    },
    {
      "source": "/en/eyelash-extensions-olten(\\.html)?",
      "destination": "/en#t-eyelash-extensions-olten",
      "permanent": true
    },
    {
      "source": "/en/ipl-hair-removal-olten(\\.html)?",
      "destination": "/en#t-ipl-hair-removal-olten",
