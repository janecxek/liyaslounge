    {
      "source": "/en/teeth-whitening-olten(\\.html)?",
      "destination": "/en#t-teeth-whitening-olten",
      "permanent": true
    },
    {
      "source": "/behandlungen(\\.html)?",
      "destination": "/#behandlungen",
      "permanent": true
    },
    {
      "source": "/preise(\\.html)?",
      "destination": "/#preisliste",
      "permanent": true
    },
    {
      "source": "/ueber-uns(\\.html)?",
      "destination": "/#ueber-uns",
      "permanent": true
    },
    {
      "source": "/kontakt(\\.html)?",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/en/treatments(\\.html)?",
      "destination": "/en#treatments",
      "permanent": true
    },
    {
      "source": "/en/prices(\\.html)?",
      "destination": "/en#price-list",
      "permanent": true
    },
    {
      "source": "/en/about(\\.html)?",
      "destination": "/en#about",
      "permanent": true
    },
    {
      "source": "/en/contact(\\.html)?",
      "destination": "/en#contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
