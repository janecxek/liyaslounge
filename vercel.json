    },
    {
      "source": "/en/dermal-fillers-olten(\\.html)?",
      "destination": "/en#t-dermal-fillers-olten",
      "permanent": true
    },
    {
      "source": "/en/wrinkle-relaxing-olten(\\.html)?",
      "destination": "/en#t-wrinkle-relaxing-olten",
      "permanent": true
    },
    {
      "source": "/en/mesotherapy-olten(\\.html)?",
      "destination": "/en#t-mesotherapy-olten",
