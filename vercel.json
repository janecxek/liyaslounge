{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/design",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/versionen",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/klassisch",
