{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/behandlungen/dermal-filler(\\.html)?",
      "destination": "/#t-dermal-filler-olten",
      "permanent": true
    },
    {
      "source": "/en/treatments/dermal-filler(\\.html)?",
      "destination": "/en#t-dermal-fillers-olten",
      "permanent": true
    },
    {
      "source": "/dermal-filler-olten(\\.html)?",
      "destination": "/#t-dermal-filler-olten",
