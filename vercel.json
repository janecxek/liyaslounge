      "destination": "/#t-hifu-olten",
      "permanent": true
    },
    {
      "source": "/morpheus8-olten(\\.html)?",
      "destination": "/#t-morpheus8-olten",
      "permanent": true
    },
    {
      "source": "/plasma-pen-olten(\\.html)?",
      "destination": "/#t-plasma-pen-olten",
      "permanent": true
    },
    {
      "source": "/permanent-make-up-olten(\\.html)?",
      "destination": "/#t-permanent-make-up-olten",
      "permanent": true
    },
    {
      "source": "/wimpernverlaengerung-olten(\\.html)?",
      "destination": "/#t-wimpernverlaengerung-olten",
      "permanent": true
    },
    {
      "source": "/ipl-haarentfernung-olten(\\.html)?",
      "destination": "/#t-ipl-haarentfernung-olten",
